MONGODB_URI=your_mongodb_connection_string
MONGODB_DB=eir_scanner

# Auth — secret used to sign session JWTs. Must be >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=your_auth_secret_min_32_chars
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=
OCR_API_URL=https://your-ocr-scanner-project.vercel.app
OCR_API_SECRET=your_ocr_api_secret
DTC_GPS_API_BASE_URL=https://gps.dtc.co.th:8099
DTC_GPS_API_TOKEN=your_dtc_gps_api_token
